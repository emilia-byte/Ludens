# Copiá este archivo a .env.local y completá los valores. En Vercel se cargan en
# Settings → Environment Variables.

# Formulario de contacto (Resend, https://resend.com)
RESEND_API_KEY=
# Remitente con el dominio verificado en Resend, por ejemplo: Web Ludens <web@ludenssa.com>
CONTACT_FROM_EMAIL=
# A quién llegan los mensajes (opcional; por defecto info@ludenssa.com)
CONTACT_TO_EMAIL=

# Google Analytics 4: solo se carga si el usuario acepta las cookies (opcional).
NEXT_PUBLIC_GA_ID=
